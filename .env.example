# Copy to .env (never commit .env)
PRIME_DB_PASSWORD=change-me
DJANGO_SECRET_KEY=change-me-in-production
# Demo login admin / admin123 is created when 1. Set 0 for anything reachable by others.
PRIME_SEED_DEMO_USER=1
# 1 = image includes OCR + semantic-model support (bigger); 0 = lean
INSTALL_OPTIONAL=1
# Optional: enables the LLM path of the AI assistant
ANTHROPIC_API_KEY=
